rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users — each player manages only their own profile document.
    // referralCode must be readable by anyone signed in, so friend-add-by-code lookups work.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      // Friends — mutual relationship. Both add-by-code and invite-link joins write
      // BOTH sides of the edge in one go (js/friends.js), and removeFriend() deletes
      // both sides too — so a player must be able to write into another player's
      // friends subcollection, but only the single doc keyed to their own uid, which
      // is exactly the reciprocal edge. Reads stay private to the owner.
      match /friends/{friendUid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null
                     && (request.auth.uid == uid || request.auth.uid == friendUid);
      }

      // FCM device tokens — one doc per registered device, owner-only.
      match /fcmTokens/{token} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Rooms — read open to any signed-in user (join-by-code needs to look up a room
    // the player isn't a member of yet). Writes restricted: only the creator may
    // create, and joining may only append the joiner's own uid to memberUids.
    match /rooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.memberUids == [request.auth.uid];
      // joinRoomByCode (js/rooms.js) writes memberUids AND updatedAt — the
      // timestamp is what the push poller (scripts/push/rooms.js) cursors on,
      // so it must be allowed alongside the roster append. The final clause
      // restores a guard FIRESTORE_RULES_FRIENDS_ROOMS.md always documented
      // but the deployed rules were missing: without it, a member already in
      // memberUids could send that same array + [own uid] again — the
      // equality check alone doesn't stop a duplicate entry, only the client
      // skipping the write does, which is not something rules can rely on.
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
                    && request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid])
                    && !(request.auth.uid in resource.data.memberUids);

      match /members/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Room invites — one doc per invited friend (js/rooms.js). The sender must
    // be a member of the room they're inviting to; only the recipient may
    // answer, exactly once, and only by flipping status.
    match /roomInvites/{inviteId} {
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.toUid
                      || request.auth.uid == resource.data.fromUid);
      allow create: if request.auth != null
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.toUid is string
                    && request.resource.data.toUid != request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.auth.uid in get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.memberUids;
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.toUid
                    && resource.data.status == 'pending'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']);
      allow delete: if false;
    }

    // Referral ledger — one row per referred player, id = that player's uid.
    // Keying by the REFERRED uid makes the payout idempotent: a second invite
    // link, a reinstall, or a replayed install referrer all resolve to the same
    // doc id and the create is rejected as already present. Full rationale in
    // FIRESTORE_RULES_REFERRALS.md.
    match /referrals/{referredUid} {
      allow read: if request.auth != null
                  && (request.auth.uid == referredUid
                      || request.auth.uid == resource.data.inviterUid);
      allow create: if request.auth != null
                    && request.auth.uid == referredUid
                    && request.resource.data.referredUid == referredUid
                    && request.resource.data.inviterUid != referredUid
                    && request.resource.data.rewardCoins == 2000
                    // Two-sided reward: invitee welcome coins, pinned like
                    // rewardCoins. Optional during the rollout so clients
                    // shipped before 2.1 (which don't send it) keep working.
                    && (!('inviteeCoins' in request.resource.data)
                        || request.resource.data.inviteeCoins == 1000)
                    && request.resource.data.claimedAt == null;
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.inviterUid
                    && resource.data.claimedAt == null
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['claimedAt']);
      allow delete: if false;
    }

    // Referral groups — everyone who joins via the same invite link becomes mutual
    // friends with everyone else already in that link's circle. `members` is an
    // append-only array; writes may only append the requester's own uid.
    match /referralGroups/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.members == [request.auth.uid];
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
                    && request.resource.data.members == resource.data.members.concat([request.auth.uid]);
    }

    // Duels — one doc per head-to-head challenge; id = the 6-char share code
    // (js/duel.js), so a code collision is a rejected create, not a silent
    // overwrite. The deck is a pure function of (seed, hand index) — see
    // js/duel-deck.js — so the five hold masks per side are the only thing a
    // player ever commits; scores are recomputed from holds by every reader
    // and never trusted from challengerScore/opponentScore, which exist only
    // for cheap UI display. winnerUid/resolvedAt/expiredAt/notifiedAt are
    // written only by the Admin SDK poller (scripts/push/duels.js), which
    // bypasses these rules entirely — no client rule below ever mentions them.
    match /duels/{duelId} {
      function isParticipant() {
        return request.auth.uid in resource.data.participants;
      }
      function isInvitee() {
        return resource.data.toUid == request.auth.uid;
      }
      function duelHoldsValid(h) {
        return h is list && h.size() == 5
            && h[0] is int && h[0] >= 0 && h[0] <= 31
            && h[1] is int && h[1] >= 0 && h[1] <= 31
            && h[2] is int && h[2] >= 0 && h[2] <= 31
            && h[3] is int && h[3] >= 0 && h[3] <= 31
            && h[4] is int && h[4] >= 0 && h[4] <= 31;
      }
      // The opponent takes an open duel by filing their five hold masks in
      // ONE write — there is no separate "accept" step, so a duel is never
      // left half-accepted. The 24h window is measured against the actual
      // request time, not anything the client controls.
      function duelSubmit() {
        return resource.data.status == 'open'
            && resource.data.opponentUid == null
            && request.auth.uid != resource.data.challengerUid
            && (resource.data.toUid == null || isInvitee())
            && request.time < resource.data.createdAt + duration.value(24, 'h')
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'opponentUid', 'opponentName', 'opponentHolds',
                           'opponentScore', 'participants', 'scoredAt'])
            && request.resource.data.status == 'scored'
            && request.resource.data.opponentUid == request.auth.uid
            && request.resource.data.opponentName is string
            && duelHoldsValid(request.resource.data.opponentHolds)
            && request.resource.data.opponentScore is int
            && request.resource.data.participants
                 == resource.data.participants.concat([request.auth.uid])
            && request.resource.data.scoredAt is timestamp;
      }
      // Each participant stamps claims.<own uid> exactly once, only once the
      // duel has settled — js/duel.js credits the pot/refund locally only
      // after this write is accepted, the same anti-double-credit mechanism
      // referrals/{uid}.claimedAt already uses.
      function duelClaim() {
        return resource.data.status in ['scored', 'expired']
            && isParticipant()
            && !(request.auth.uid in resource.data.claims)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claims'])
            && request.resource.data.claims.diff(resource.data.claims).affectedKeys()
                 .hasOnly([request.auth.uid])
            && request.resource.data.claims[request.auth.uid] is timestamp;
      }
      // Funnel only: the challenger records which channel an open duel's
      // link went out on.
      function duelShareMark() {
        return resource.data.status == 'open'
            && request.auth.uid == resource.data.challengerUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharedVia'])
            && request.resource.data.sharedVia is list;
      }

      // An open duel is readable by any signed-in user (a link-clicker who
      // isn't a participant yet must be able to preview it before taking
      // it); once it's no longer open, only the two players and whoever was
      // invited may read it.
      allow get: if request.auth != null
                 && (resource.data.status == 'open' || isParticipant() || isInvitee());
      allow list: if request.auth != null && (isParticipant() || isInvitee());
      allow create: if request.auth != null
                    && duelId.size() == 6
                    && request.resource.data.challengerUid == request.auth.uid
                    && request.resource.data.challengerName is string
                    && request.resource.data.participants == [request.auth.uid]
                    && request.resource.data.status == 'open'
                    && request.resource.data.seed is int
                    && request.resource.data.seed >= 0
                    && request.resource.data.seed <= 4294967295
                    && request.resource.data.fee in [0, 100]
                    && duelHoldsValid(request.resource.data.challengerHolds)
                    && request.resource.data.challengerScore is int
                    && request.resource.data.opponentUid == null
                    && request.resource.data.opponentHolds == null
                    && (request.resource.data.toUid == null
                        || (request.resource.data.toUid is string
                            && request.resource.data.toUid != request.auth.uid))
                    && request.resource.data.claims == {}
                    && request.resource.data.createdAt is timestamp;
      allow update: if request.auth != null
                    && (duelSubmit() || duelClaim() || duelShareMark());
      allow delete: if false;
    }

    // config/features — remote feature toggles read by every client on load,
    // including signed-out players, so read must stay public. Only the admin
    // account may write.
    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'micorlov@gmail.com';
    }

    // Hourly champions leaderboard (js/champions.js) + bracelets bonus fields.
    match /hourly/{hourKey} {
      allow read: if request.auth != null;
      match /entries/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Daily max-win bracelets — same shape as hourly above.
    match /dailyMaxWin/{dayKey} {
      allow read: if request.auth != null;
      match /entries/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Permanent bracelet award records — written only by the Admin SDK
    // (scripts/bracelets/award.js), which bypasses these rules; clients read-only.
    match /bracelets/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Daily net-profit leaderboard, doc id `{dayKey}_{uid}` (js/leaderboards.js).
    // Every write includes a `uid` field matching the writer, checked instead of
    // parsing the doc id.
    match /daily_scores/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // Admin-panel event banners — admin-only, no client (other than admin.html) reads these.
    match /events/{eventId} {
      allow read, write: if request.auth != null
                         && request.auth.token.email == 'micorlov@gmail.com';
    }

    // Push-poll cursor doc — written only by the Admin SDK poller; admin.html
    // reads it just to display last-poll time.
    match /system/{docId} {
      allow read: if request.auth != null && request.auth.token.email == 'micorlov@gmail.com';
      allow write: if false;
    }

    // Collection-group reads for the admin center's audience preview. The
    // owner-only rules above still govern every write and every player's own
    // reads; these add read access for the admin account alone, which is what
    // lets push-admin.html show "N devices across M users" before a send.
    // A collection-group query needs its own {path=**} match — the nested
    // match blocks above only cover direct document access.
    match /{path=**}/fcmTokens/{token} {
      allow read: if request.auth != null
                  && request.auth.token.email == 'micorlov@gmail.com';
    }

    match /{path=**}/friends/{friendUid} {
      allow read: if request.auth != null
                  && request.auth.token.email == 'micorlov@gmail.com';
    }

    // Push campaigns composed in push-admin.html. The admin page can never hold
    // a service-account credential, so it writes intent here and the GitHub
    // Actions poller (scripts/push/campaigns.js, Admin SDK, bypasses these
    // rules) performs the delivery and writes results back. Admin-only both
    // ways: a campaign doc names its audience and carries the message body.
    match /pushCampaigns/{campaignId} {
      allow read, write: if request.auth != null
                         && request.auth.token.email == 'micorlov@gmail.com';
    }

    // pushLogs/{logId} — one doc per recipient per notification. Written only
    // by scripts/lib/pushLog.js (Admin SDK, bypasses these rules); every send
    // path now runs server-side, so no client needs create access.
    // Admin-only read: entries carry display names and notification bodies
    // for every user. Append-only — nothing edits or deletes log entries.
    match /pushLogs/{logId} {
      allow read: if request.auth != null && request.auth.token.email == 'micorlov@gmail.com';
      allow write: if false;
    }
  }
}
