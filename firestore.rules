rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users — each player manages only their own profile document.
    // referralCode must be readable by anyone signed in, so friend-add-by-code lookups work.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      // Friends — mutual relationship. Both add-by-code and invite-link joins write
      // BOTH sides of the edge in one go (js/friends.js), and removeFriend() deletes
      // both sides too — so a player must be able to write into another player's
      // friends subcollection, but only the single doc keyed to their own uid, which
      // is exactly the reciprocal edge. Reads stay private to the owner.
      match /friends/{friendUid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null
                     && (request.auth.uid == uid || request.auth.uid == friendUid);
      }

      // FCM device tokens — one doc per registered device, owner-only.
      match /fcmTokens/{token} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Rooms — read open to any signed-in user (join-by-code needs to look up a room
    // the player isn't a member of yet). Writes restricted: only the creator may
    // create, and joining may only append the joiner's own uid to memberUids.
    match /rooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.memberUids == [request.auth.uid];
      // joinRoomByCode (js/rooms.js) writes memberUids AND updatedAt — the
      // timestamp is what the push poller (scripts/push/rooms.js) cursors on,
      // so it must be allowed alongside the roster append.
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
                    && request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid]);

      match /members/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Room invites — one doc per invited friend (js/rooms.js). The sender must
    // be a member of the room they're inviting to; only the recipient may
    // answer, exactly once, and only by flipping status.
    match /roomInvites/{inviteId} {
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.toUid
                      || request.auth.uid == resource.data.fromUid);
      allow create: if request.auth != null
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.toUid is string
                    && request.resource.data.toUid != request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.auth.uid in get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.memberUids;
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.toUid
                    && resource.data.status == 'pending'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']);
      allow delete: if false;
    }

    // Referral ledger — one row per referred player, id = that player's uid.
    // Keying by the REFERRED uid makes the payout idempotent: a second invite
    // link, a reinstall, or a replayed install referrer all resolve to the same
    // doc id and the create is rejected as already present. Full rationale in
    // FIRESTORE_RULES_REFERRALS.md.
    match /referrals/{referredUid} {
      allow read: if request.auth != null
                  && (request.auth.uid == referredUid
                      || request.auth.uid == resource.data.inviterUid);
      allow create: if request.auth != null
                    && request.auth.uid == referredUid
                    && request.resource.data.referredUid == referredUid
                    && request.resource.data.inviterUid != referredUid
                    && request.resource.data.rewardCoins == 2000
                    && request.resource.data.claimedAt == null;
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.inviterUid
                    && resource.data.claimedAt == null
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['claimedAt']);
      allow delete: if false;
    }

    // Referral groups — everyone who joins via the same invite link becomes mutual
    // friends with everyone else already in that link's circle. `members` is an
    // append-only array; writes may only append the requester's own uid.
    match /referralGroups/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.members == [request.auth.uid];
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
                    && request.resource.data.members == resource.data.members.concat([request.auth.uid]);
    }

    // config/features — remote feature toggles read by every client on load,
    // including signed-out players, so read must stay public. Only the admin
    // account may write.
    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'micorlov@gmail.com';
    }

    // Hourly champions leaderboard (js/champions.js) + bracelets bonus fields.
    match /hourly/{hourKey} {
      allow read: if request.auth != null;
      match /entries/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Daily max-win bracelets — same shape as hourly above.
    match /dailyMaxWin/{dayKey} {
      allow read: if request.auth != null;
      match /entries/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Permanent bracelet award records — written only by the Admin SDK
    // (scripts/bracelets/award.js), which bypasses these rules; clients read-only.
    match /bracelets/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Daily net-profit leaderboard, doc id `{dayKey}_{uid}` (js/leaderboards.js).
    // Every write includes a `uid` field matching the writer, checked instead of
    // parsing the doc id.
    match /daily_scores/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // Admin-panel event banners — admin-only, no client (other than admin.html) reads these.
    match /events/{eventId} {
      allow read, write: if request.auth != null
                         && request.auth.token.email == 'micorlov@gmail.com';
    }

    // Push-poll cursor doc — written only by the Admin SDK poller; admin.html
    // reads it just to display last-poll time.
    match /system/{docId} {
      allow read: if request.auth != null && request.auth.token.email == 'micorlov@gmail.com';
      allow write: if false;
    }

    // Queued test push sends — Admin SDK only (scripts/push/testQueue.js); no
    // client currently writes this collection.
    match /pushTestQueue/{docId} {
      allow read, write: if false;
    }

    // pushLogs/{logId} — one doc per recipient per notification. Written by
    // scripts/lib/pushLog.js (Admin SDK, bypasses these rules) and by
    // admin.html's "Send Now" test sender, so that one needs create access.
    // Admin-only read: entries carry display names and notification bodies
    // for every user. Append-only — nothing edits or deletes log entries.
    match /pushLogs/{logId} {
      allow read, create: if request.auth != null && request.auth.token.email == 'micorlov@gmail.com';
      allow update, delete: if false;
    }
  }
}
